# Секреты задаются только в локальном .env или в Render Environment.
TELEGRAM_BOT_TOKEN=replace_with_new_bot_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id

# Один или несколько точных адресов frontend через запятую.
ALLOWED_ORIGINS=https://YOUR-FRONTEND.onrender.com

# Backend hostname и дополнительные собственные домены через запятую.
TRUSTED_HOSTS=YOUR-BACKEND.onrender.com,localhost,127.0.0.1

# Необязательные лимиты. Значения ниже совпадают со значениями по умолчанию.
MAX_BODY_BYTES=16384
GLOBAL_RATE_LIMIT=120
GLOBAL_RATE_WINDOW_SECONDS=60
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=600
RATE_LIMIT_MAX_CLIENTS=10000
